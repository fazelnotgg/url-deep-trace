{
  "name": "@fazelstudio/url-deep-trace",
  "version": "1.1.1",
  "description": "Advanced URL tracing engine with SSL forensics, threat intelligence, ML classification, and security risk scoring",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "node test/optimization-test.js",
    "test:security": "node test/testing.js",
    "test:all": "node test/optimization-test.js",
    "example": "node examples/basic-usage.js",
    "example:advanced": "node examples/advanced-usage.js",
    "server": "node examples/api-server.js",
    "dev:server": "nodemon examples/api-server.js",
    "lint": "eslint src/ --max-warnings 100",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\""
  },
  "files": [
    "src"
  ],
  "keywords": [
    "url",
    "trace",
    "forensics",
    "security",
    "ssl",
    "tls",
    "redirect",
    "phishing",
    "malware",
    "threat-intelligence",
    "machine-learning",
    "homoglyph",
    "dns",
    "risk-scoring"
  ],
  "author": {
    "name": "Fazel",
    "email": "zulfazlilsm@gmail.com",
    "url": "https://github.com/fazelllyyy"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "tough-cookie": "^4.1.3"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.2.0"
  },
  "optionalDependencies": {
    "playwright": "^1.40.1",
    "puppeteer": "^21.6.1"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fazelllyyy/url-deep-trace.git"
  },
  "bugs": {
    "url": "https://github.com/fazelllyyy/url-deep-trace/issues"
  },
  "homepage": "https://github.com/fazelllyyy/url-deep-trace#readme"
}
